# ==============================================================================
# MERIDIAN LEARNING ORBIT — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# For Vercel Production Deployment:
#   Add these variables in Vercel Project Settings -> Environment Variables.
# ==============================================================================

# Server Environment
PORT=5000
NODE_ENV=production

# Supabase Database & Auth Configuration
# Obtain from: Supabase Project Settings -> API
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Google Gemini AI API Configuration
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Client & CORS Configuration
# Set to your production Vercel frontend URL or comma-separated list of allowed domains
CLIENT_URL=https://your-frontend-app.vercel.app
ALLOWED_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:5173

# Storage Configuration
STORAGE_RESUME_BUCKET=resumes
